{
  // Cloudflare Worker "ohtuleht-api": stores briefs and clients in a D1 database.
  "name": "ohtuleht-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ohtuleht-db",
      // Filled in after "yarn wrangler d1 create ohtuleht-db" (the id is not a secret).
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Addresses allowed to call the API from a browser.
    "ALLOWED_ORIGINS": "https://deniss-ee.github.io,http://localhost:5173",
    // "open" = no login yet, TEST DATA ONLY. Later "entra" = Microsoft login required.
    "AUTH_MODE": "open"
  }
}
